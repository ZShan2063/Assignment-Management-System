DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-render-app-name.onrender.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Optional: use Cloudinary for assignment/submission uploads in production.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
